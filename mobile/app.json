{
  "expo": {
    "name": "Lantante Emploi",
    "slug": "lantante-emploi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "lantante",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.lantantetechnologie.emploi",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "Pour choisir votre photo de profil ou l'image d'une publication.",
        "NSCameraUsageDescription": "Pour prendre une photo de profil ou de publication."
      }
    },
    "android": {
      "package": "com.lantantetechnologie.emploi",
      "adaptiveIcon": {
        "backgroundColor": "#0d3b7a",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0d3b7a",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0d3b7a"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Pour choisir votre photo de profil ou l'image d'une publication."
        }
      ],
      "expo-sharing",
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "router": {},
      "eas": {}
    },
    "experiments": {
      "typedRoutes": false
    }
  }
}
