SECRET_KEY=change-me-generate-a-real-random-value
DEBUG=False
DATABASE_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# ── Déploiement hors Render (ex : VPS Hostinger) ──
# Domaines/IP autorisés, séparés par des virgules.
ALLOWED_HOSTS=lucastech.tg,www.lucastech.tg
# Origines HTTPS autorisées pour les requêtes CSRF (POST/formulaires).
CSRF_TRUSTED_ORIGINS=https://lucastech.tg,https://www.lucastech.tg
# Mettre à True seulement une fois le certificat SSL (certbot) confirmé
# fonctionnel — sinon la redirection forcée HTTPS rend le site inaccessible.
USE_HTTPS=False
