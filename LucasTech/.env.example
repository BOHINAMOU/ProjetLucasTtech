SECRET_KEY=change-me-generate-a-real-random-value
DEBUG=False
DATABASE_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# ── Déploiement hors Render (ex : VPS Hostinger) ──
# Domaines/IP autorisés, séparés par des virgules. Sans domaine pour
# l'instant, mettez l'IP du serveur (ex : ALLOWED_HOSTS=123.45.67.89) ;
# une fois un domaine pointé dessus, ajoutez-le ici (ex :
# ALLOWED_HOSTS=123.45.67.89,lucastech.tg,www.lucastech.tg).
ALLOWED_HOSTS=
# Origines HTTPS autorisées pour les requêtes CSRF (POST/formulaires) —
# à renseigner seulement une fois le HTTPS actif (voir USE_HTTPS).
CSRF_TRUSTED_ORIGINS=
# Certbot exige un vrai domaine : laisser à False tant que vous accédez
# au site par IP nue. Repasser à True une fois le certificat SSL
# confirmé fonctionnel sur un domaine — sinon la redirection HTTPS
# forcée rend le site inaccessible.
USE_HTTPS=False
